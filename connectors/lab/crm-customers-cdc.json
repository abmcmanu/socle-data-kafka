{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "${file:/opt/secrets/connect-secrets.properties:crm.user}",
  "database.password": "${file:/opt/secrets/connect-secrets.properties:crm.password}",
  "database.dbname": "crm",
  "topic.prefix": "crm",
  "table.include.list": "public.customers",
  "column.exclude.list": "public.customers.phone,public.customers.birth_date",
  "publication.name": "dbz_crm_publication",
  "publication.autocreate.mode": "disabled",
  "slot.name": "debezium_crm",
  "snapshot.mode": "initial",
  "decimal.handling.mode": "string",
  "time.precision.mode": "connect",
  "transforms": "unwrap,route,key",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.delete.tombstone.handling.mode": "tombstone",
  "transforms.unwrap.add.fields": "op,source.ts_ms",
  "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.route.regex": "crm\\.public\\.customers",
  "transforms.route.replacement": "crm.cdc.customers.v1",
  "transforms.key.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
  "transforms.key.field": "id",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schema.registry.url": "http://schema-registry:8081",
  "value.converter.auto.register.schemas": "true"
}
