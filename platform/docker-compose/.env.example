# Copié en .env par `make up` s'il n'existe pas. Valeurs de LAB uniquement.
# Identifiant du cluster KRaft (22 caractères base64) : bin/kafka-storage.sh random-uuid
CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_IMAGE_TAG=4.1.2
CONFLUENT_VERSION=8.0.0
HADOOP_VERSION=3.4.1
JMX_EXPORTER_VERSION=1.0.1
# Vérifier la dernière version sur https://www.confluent.io/hub/confluentinc/kafka-connect-hdfs
HDFS_CONNECTOR_VERSION=10.2.15
POSTGRES_PASSWORD=crm-lab-password
GRAFANA_ADMIN_PASSWORD=admin
# Ports côté hôte, à décommenter si un port est déjà pris sur la machine
# KAFKA_UI_PORT=8080
# SCHEMA_REGISTRY_PORT=8081
# CONNECT_PORT=8083
# INGESTION_API_PORT=8090
