extends: default
ignore: |
  platform/ansible/roles/*/templates/
  services/**/target/
  .git/
rules:
  line-length:
    max: 200
    level: warning
    ignore: |
      platform/strimzi/monitoring/
  document-start: disable
  truthy: {allowed-values: ["true", "false", "yes", "no", "on"], check-keys: false}
  comments: {min-spaces-from-content: 1}
  comments-indentation: disable
  braces: {max-spaces-inside: 1}
  brackets: {max-spaces-inside: 1}
  indentation: {spaces: 2, indent-sequences: whatever}
  new-lines: {type: unix}
