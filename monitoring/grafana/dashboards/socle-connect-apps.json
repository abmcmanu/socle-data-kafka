    {
      "type": "stat",
      "title": "Messages en DLQ (24 h)",
      "description": "Messages envoyés en DLQ par les connecteurs sink.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(delta(kafka_connect_task_error_deadletterqueue_produce_requests[24h])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
