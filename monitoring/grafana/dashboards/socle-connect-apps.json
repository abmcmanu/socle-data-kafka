    {
      "type": "timeseries",
      "title": "Requêtes HTTP par statut",
      "description": "202 = commande acceptée, 400 = invalide, 503 = Kafka indisponible.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"ingestion-api\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
