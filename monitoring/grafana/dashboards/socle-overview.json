      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{topic!~\"__.*|_.*\", topic!=\"\"}[5m]))",
